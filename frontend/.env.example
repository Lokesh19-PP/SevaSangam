# =========================================================
# SevaSangam Frontend — Environment Variables
# =========================================================

# API Base URL (points to FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000/api

# Use mock API instead of real backend (true/false)
VITE_USE_MOCK_API=true

# Authentication provider (auth0 | firebase)
VITE_AUTH_PROVIDER=firebase

# Firebase config (if using Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Auth0 config (if using Auth0)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Google Maps API Key (for geospatial features)
VITE_GOOGLE_MAPS_API_KEY=

# Default language (en | hi | mr)
VITE_DEFAULT_LANGUAGE=en
